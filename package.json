{
  "name": "cafe-rene",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @rene/api\" \"npm run dev -w @rene/web\"",
    "build": "npm run build -w @rene/web",
    "typecheck": "tsc --noEmit && npm run typecheck -w @rene/mobile",
    "lint": "eslint apps packages",
    "test": "tsx --test apps/api/test/*.test.ts",
    "mobile": "npm run start -w @rene/mobile",
    "worker": "npm run worker -w @rene/api",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.46.0"
  }
}
