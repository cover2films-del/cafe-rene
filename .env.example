# Demo mode only; APP_MODE=live refuses to start.
APP_MODE=demo
PORT=3001
# Set for persistent sessions/QR signatures across server restarts; minimum 32 random bytes.
SESSION_SECRET=
MOCK_WEBHOOK_SECRET=
# Without DATABASE_URL the demo uses embedded PostgreSQL in work/database.
DATABASE_URL=
# Production transport deployment requires HTTPS and secure cookies.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional read-only Meta import. Never use EXPO_PUBLIC_ for these credentials.
# Use your approved Meta app's supported Graph version, e.g. vXX.0 (not a literal XX).
META_GRAPH_VERSION=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Instagram professional account using Facebook Login / linked Page access:
META_INSTAGRAM_ACCOUNT_ID=
META_INSTAGRAM_ACCESS_TOKEN=
# Public website artwork refresh (server awake); credentials required for Meta sources.
CONTENT_REFRESH_MINUTES=15
# User-authorised venue social posts may publish to the feed; event dates still require review.
SOCIAL_AUTO_PUBLISH=true
# Push delivery needs an update-enabled signed app with Apple APNs credentials and explicit opt-in.
# Defaults to enabled; set false to pause the sender. No tokens exist until a phone registers.
PUSH_DELIVERY_ENABLED=true
# Optional Expo push access security token; server only, never EXPO_PUBLIC.
EXPO_PUSH_ACCESS_TOKEN=
